{
  "name": "banana-game-enterprise-suite",
  "version": "1.0.0",
  "description": "CIS046-3 Software For Enterprise - Banana Game Full Stack System",
  "scripts": {
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"yellow,cyan\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "start": "concurrently -n \"BACKEND,FRONTEND\" -c \"yellow,cyan\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "install:all": "cd backend && npm install && cd ../frontend && npm install",
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "cd frontend && npm run dev",
    "init:db": "cd backend && npm run db:init"
  },
  "keywords": [
    "banana-game",
    "enterprise",
    "react",
    "express",
    "mysql"
  ],
  "devDependencies": {
    "concurrently": "^9.2.5"
  }
}
